algoritmo "Exercício 04 - Tratamento de OutroCaso"

var
   codigo: inteiro

inicio
   codigo <- 99

   escolha codigo
      caso 1
         escreva("Produto A")
      caso 2
         escreva("Produto B")
      outrocaso
         escreva("Código não encontrado no sistema.")

   fimescolha
fimalgoritmo