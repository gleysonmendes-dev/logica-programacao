algoritmo "Exercício 02 - Menu Escolha Caso"

var
   opcao: inteiro

inicio
   opcao <- 1

   escolha opcao
      caso 1
         escreva("Opção de Cadastro selecionada.")
      caso 2
         escreva("Opção de Relatórios selecionada.")
      outrocaso
         escreva("Opção inválida.")
   fimescolha
fimalgoritmo