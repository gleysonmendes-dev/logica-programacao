algoritmo "Exercício 10 - Estrutura Encadeada Exemplo"

var
   numero: inteiro

inicio
   numero <- 0

   se (numero > 0) entao
      escreva("Número Positivo")
   senao
      se (numero < 0) entao
         escreva("Número Negativo")
      senao
         escreva("Número Neutro (Zero)")
      fimse
   fimse
fimalgoritmo